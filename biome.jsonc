{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noUnknownAtRules": "off",
        "noUnknownAttribute": {
          "level": "error",
          "options": {
            "ignore": ["cmdk-input-wrapper"]
          }
        }
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  }
}
