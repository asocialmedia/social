{
  "extends": "@asm/config/react.tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@asm/*": ["../*"],
      "@ui/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `native/` holds React Native code and has its own tsconfig rooted on the
  // Expo base config. Excluded here so the web project never typechecks RN
  // files under the `next` plugin and DOM libs.
  "exclude": ["node_modules", "native"]
}
