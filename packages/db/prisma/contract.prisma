  model Notifications {
    id          String                    @id(map: "notifications_pkey") @default(uuid())
    recipientId String
    issuerId    String
    postId      String?
    commentId   String?
    _type       pg.enum(NotificationType) @map("type")
    read        Boolean                   @default(false)
    createdAt   Timestamp(3)              @default(now())
    communityId String?
    // The conversation a DEN_MESSAGE belongs to: the den's name is the second
    // half of that notification's copy ("Alice in Study group: sent a
    // message"), and with forty notifications in an inbox the den is what says
    // which thread any of them belong to. The den row is joined for the name
    // rather than copied, so a rename moves every row that names it.
    //
    // Never carries message content. The server only ever holds ciphertext, so
    // there is nothing here a push could quote, and no message id to tempt a
    // future join that would put one there. Cascade, like postId and
    // communityId: a dissolved den takes its notifications with it.
    conversationId String?
    count       Int                       @default(1)
    comment     Comments?                 @relation(fields:[commentId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_commentId_fkey")
    community   Communities?              @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_communityId_fkey", index: false)
    conversation MessageConversations?    @relation(fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_conversationId_fkey", index: false)
    issuer      Users                     @relation(name: "notifications_issuerId_fkey", fields:[issuerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_issuerId_fkey", index: false)
    post        Posts?                    @relation(fields:[postId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_postId_fkey", index: false)
    recipient   Users                     @relation(name: "notifications_recipientId_fkey", fields:[recipientId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_recipientId_fkey", index: false)

    @@index([commentId], map: "notifications_commentId_idx")
    @@index([issuerId, _type, createdAt], map: "notifications_issuerId_type_createdAt_idx")
    // The den fan-out's fold lookup: one row per recipient per den while it is
    // unread, found on every message a member sends. Same shape as the
    // community index above, which serves the same fold for community posts.
    @@index([recipientId, conversationId, _type, read], map: "notifications_recipientId_conversationId_type_read_idx")
    @@index([recipientId, communityId, _type, read], map: "notifications_recipientId_communityId_type_read_idx")
    @@index([recipientId, createdAt], map: "notifications_recipientId_createdAt_idx")
    @@index([recipientId, read], map: "notifications_recipientId_read_idx")
    @@map("notifications")
  }

