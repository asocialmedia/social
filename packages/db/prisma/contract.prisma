  model Messages {
    id             String               @id(map: "messages_pkey") @default(uuid())
    conversationId String
    senderId       String
    ciphertext     String
    iv             String
    ratchetIndex   Int                  @default(0)
    revision       Int                  @default(1)
    keyEpoch       Int?
    creationSequence Int                @default(0)
    createdAt      Timestamp(3)         @default(now())
