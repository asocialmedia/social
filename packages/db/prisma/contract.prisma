// use prisma-8
namespace public {
  model Communities {
    id                     String                   @id(map: "communities_pkey") @default(uuid())
    slug                   String
    name                   String
    description            String
    topics                 String[]?
    _type                  pg.enum(CommunityType)   @default("PUBLIC") @map("type")
    mature                 Boolean                  @default(false)
    accentColor            String                   @default("slate")
    ownerId                String
    avatarUrl              String?
    avatarKey              String?
    avatarMediaId          String?
    bannerUrl              String?
    bannerKey              String?
    bannerMediaId          String?
    createdAt              Timestamp(3)             @default(now())
    updatedAt              Timestamp(3)             @default(now())
    communityJoinBonuses   CommunityJoinBonuses[]
    communityMembers       CommunityMembers[]
    communityPostShares    CommunityPostShares[]
    communitySubscriptions CommunitySubscriptions[]
    communityVisits        CommunityVisits[]
    notifications          Notifications[]
    posts                  Posts[]
    avatarMedia            PostMedia?               @relation(name: "communities_avatarMediaId_fkey", fields:[avatarMediaId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "communities_avatarMediaId_fkey")
    bannerMedia            PostMedia?               @relation(name: "communities_bannerMediaId_fkey", fields:[bannerMediaId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "communities_bannerMediaId_fkey")
    owner                  Users                    @relation(fields:[ownerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "communities_ownerId_fkey")

    @@unique([avatarMediaId], map: "communities_avatarMediaId_key")
    @@unique([bannerMediaId], map: "communities_bannerMediaId_key")
    @@index([createdAt], map: "communities_createdAt_idx")
    @@index(expression: "description gin_trgm_ops", name: "communities_description_trgm_idx", type: "gin")
    @@index(expression: "name gin_trgm_ops", name: "communities_name_trgm_idx", type: "gin")
    @@index([ownerId], map: "communities_ownerId_idx")
    @@index(expression: "slug gin_trgm_ops", name: "communities_slug_trgm_idx", type: "gin")
    @@unique([slug], map: "communities_slug_key")
    @@index([topics], map: "communities_topics_idx", type: "gin")
    @@index([_type], map: "communities_type_idx")
    @@map("communities")
  }

  model Posts {
    id                                     String                 @id(map: "posts_pkey") @default(uuid())
    content                                String
    userId                                 String
    aura                                   Int                    @default(0)
    viewCount                              Int                    @default(0)
    lastAwardedViewCount                   Int                    @default(0)
    lastAwardedShareCount                  Int                    @default(0)
    trendingScore                          Float                  @default(0)
    isGust                                 Boolean                @default(false)
    moderated                              Boolean                @default(false)
    explicitContent                        Boolean                @default(false)
    embeds                                 Jsonb?
    createdAt                              Timestamp(3)           @default(now())
    embedding                              Float[]?
    semanticTags                           String[]?
    parentPostId                           String?
    rootPostId                             String?
    threadTopId                            String?
    communityId                            String?
    postToTags                             PostToTag[]
    auraLogs                               AuraLogs[]
    bookmarks                              Bookmarks[]
    comments                               Comments[]
    hnStoryShares                          HnStoryShares[]
    mentions                               Mentions[]
    notifications                          Notifications[]
    postMedias                             PostMedia[]
    postVisits                             PostVisits[]
    recommendationEvents                   RecommendationEvents[]
    shareStats                             ShareStats[]
    votes                                  Votes[]
    communityPostShares                    CommunityPostShares[]  @relation(name: "community_post_shares_postId_fkey")
    communityPostSharesCommunityPostShares CommunityPostShares[]  @relation(name: "community_post_shares_sourcePostId_fkey")
    community                              Communities?           @relation(fields:[communityId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "posts_communityId_fkey", index: false)
    parentPost                             Posts?                 @relation(name: "posts_parentPostId_fkey", fields:[parentPostId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "posts_parentPostId_fkey", index: false)
    posts                                  Posts[]                @relation(name: "posts_parentPostId_fkey")
    user                                   Users                  @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "posts_userId_fkey", index: false)

    @@index([communityId, aura], map: "posts_communityId_aura_idx")
    @@index([communityId, createdAt], map: "posts_communityId_createdAt_idx")
    @@index(expression: "content gin_trgm_ops", name: "posts_content_trgm_idx", type: "gin")
    @@index([isGust, aura, id], map: "posts_isGust_aura_id_idx")
    @@index([isGust, createdAt], map: "posts_isGust_createdAt_idx")
    @@index([isGust, trendingScore, id], map: "posts_isGust_trendingScore_id_idx")
    @@index([parentPostId, createdAt], map: "posts_parentPostId_createdAt_idx")
    @@index([rootPostId, createdAt], map: "posts_rootPostId_createdAt_idx")
    @@index([threadTopId, createdAt], map: "posts_threadTopId_createdAt_idx")
    @@index([userId, isGust, createdAt], map: "posts_userId_isGust_createdAt_idx")
    @@map("posts")
  }

  model Comments {
    id               String          @id(map: "comments_pkey") @default(uuid())
    content          String
    userId           String
    postId           String
    parentId         String?
    rootId           String?
    aura             Int             @default(0)
    creationAura     Int             @default(0)
    receivedAura     Int             @default(0)
    postReceivedAura Int             @default(0)
    deleted          Boolean         @default(false)
    createdAt        Timestamp(3)    @default(now())
    auraLogs         AuraLogs[]
    commentVotes     CommentVotes[]
    notifications    Notifications[]
    postMedias       PostMedia[]
    parent           Comments?       @relation(name: "comments_parentId_fkey", fields:[parentId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "comments_parentId_fkey", index: false)
    comments         Comments[]      @relation(name: "comments_parentId_fkey")
    post             Posts           @relation(fields:[postId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "comments_postId_fkey", index: false)
    root             Comments?       @relation(name: "comments_rootId_fkey", fields:[rootId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "comments_rootId_fkey", index: false)
    commentsComments Comments[]      @relation(name: "comments_rootId_fkey")
    user             Users           @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "comments_userId_fkey", index: false)

    @@index([postId, createdAt], map: "comments_postId_createdAt_idx")
    @@index([postId, parentId], map: "comments_postId_parentId_idx")
    @@index([postId, rootId, createdAt], map: "comments_postId_rootId_createdAt_idx")
    @@map("comments")
  }

  model MessageConversations {
    id                         String                       @id(map: "message_conversations_pkey") @default(uuid())
    pairKey                    String?
    createdAt                  Timestamp(3)                 @default(now())
    updatedAt                  Timestamp(3)                 @default(now())
    messageConversationKeys    MessageConversationKeys[]
    messageConversationMembers MessageConversationMembers[]
    messages                   Messages[]
    postMedias                 PostMedia[]

    @@unique([pairKey], map: "message_conversations_pairKey_key")
    @@map("message_conversations")
  }

  model PostMedia {
    id                     String                    @id(map: "post_media_pkey") @default(uuid())
    postId                 String?
    commentId              String?
    userId                 String?
    url                    String
    key                    String                    @default("")
    mimeType               String                    @default("application/octet-stream")
    _type                  pg.enum(MediaType)        @default("IMAGE") @map("type")
    size                   Int                       @default(0)
    width                  Int?
    height                 Int?
    thumbnailKey           String?
    thumbnailWidth         Int?
    thumbnailHeight        Int?
    customThumbnailKey     String?
    hasHls                 Boolean                   @default(false)
    createdAt              Timestamp(3)              @default(now())
    status                 pg.enum(MediaStatus)      @default("UPLOADING")
    visibility             pg.enum(MediaVisibility)  @default("PUBLIC")
    originalKey            String?
    publishedKey           String?
    claimedMime            String?
    detectedMime           String?
    originalName           String?
    sha256                 String?
    phash                  String?
    rejectedReason         pg.enum(RejectionReason)?
    failureCode            String?
    failureDetail          Jsonb?
    attempts               Int                       @default(0)
    techMetadata           Jsonb?
    exifStripped           Boolean                   @default(false)
    altText                String?
    generatedAltText       String?
    ocrText                String?
    safety                 Jsonb?
    semantics              Jsonb?
    aiGenerated            Boolean?
    aiProvenance           Jsonb?
    pipelineVersion        String?
    processedAt            Timestamp(3)?
    audioOverlayId         String?
    updatedAt              Timestamp(3)              @default(now())
    blurDataUrl            String?
    platform               String                    @default("asocialmedia.cc")
    uploaderDisplayName    String?
    uploaderUsername       String?
    encoderVersion         String?
    duplicateOf            String?
    originalProvenanceId   String?
    reShareChecked         Boolean                   @default(false)
    captionsKey            String?
    semanticTags           String[]?
    transcript             String?
    messageConversationId  String?
    postMediaDerivatives   PostMediaDerivatives[]
    communities            Communities[]             @relation(name: "communities_avatarMediaId_fkey")
    communitiesCommunities Communities[]             @relation(name: "communities_bannerMediaId_fkey")
    audioOverlay           PostMedia?                @relation(name: "post_media_audioOverlayId_fkey", fields:[audioOverlayId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "post_media_audioOverlayId_fkey")
    postMedia              PostMedia[]               @relation(name: "post_media_audioOverlayId_fkey")
    comment                Comments?                 @relation(fields:[commentId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "post_media_commentId_fkey")
    messageConversation    MessageConversations?     @relation(fields:[messageConversationId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "post_media_messageConversationId_fkey")
    post                   Posts?                    @relation(fields:[postId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "post_media_postId_fkey")
    users                  Users[]                   @relation(name: "users_avatarMediaId_fkey")
    usersUsers             Users[]                   @relation(name: "users_bannerMediaId_fkey")

    @@unique([audioOverlayId], map: "post_media_audioOverlayId_key")
    @@index([commentId], map: "post_media_commentId_idx")
    @@index([duplicateOf], map: "post_media_duplicateOf_idx")
    @@index([messageConversationId], map: "post_media_messageConversationId_idx")
    @@index([originalProvenanceId], map: "post_media_originalProvenanceId_idx")
    @@index([phash], map: "post_media_phash_idx")
    @@index([postId], map: "post_media_postId_idx")
    @@index([reShareChecked], map: "post_media_reShareChecked_idx")
    @@index([sha256], map: "post_media_sha256_idx")
    @@index([status], map: "post_media_status_idx")
    @@index([userId, createdAt], map: "post_media_userId_createdAt_idx")
    @@map("post_media")
  }

  model Users {
    id                         String                       @id(map: "users_pkey") @default(uuid())
    aura                       Int                          @default(0)
    username                   String
    displayName                String
    displayUsername            String?
    email                      String?
    passwordHash               String?
    googleId                   String?
    githubId                   String?
    discordId                  String?
    twitterId                  String?
    redditId                   String?
    avatarUrl                  String?
    avatarKey                  String?
    avatarMediaId              String?
    bannerUrl                  String?
    bannerKey                  String?
    bannerMediaId              String?
    bio                        String?
    githubUsername             String?
    linkedinUsername           String?
    twitterUsername            String?
    redditUsername             String?
    customDomain               String?
    emailVerified              Boolean                      @default(false)
    emailVerifiedAt            Timestamp(3)?
    image                      String?
    name                       String?
    role                       String                       @default("user")
    badge                      String?
    badges                     String[]?
    banned                     Boolean                      @default(false)
    banReason                  String?
    banExpires                 Timestamp(3)?
    createdAt                  Timestamp(3)                 @default(now())
    updatedAt                  Timestamp(3)                 @default(now())
    lastLoginMethod            String?
    twoFactorEnabled           Boolean                      @default(false)
    hNBookmarks                HNBookmark[]
    accounts                   Accounts[]
    bookmarks                  Bookmarks[]
    commentVotes               CommentVotes[]
    comments                   Comments[]
    communities                Communities[]
    communityJoinBonuses       CommunityJoinBonuses[]
    communityMembers           CommunityMembers[]
    communitySubscriptions     CommunitySubscriptions[]
    communityVisits            CommunityVisits[]
    devicePushTokens           DevicePushTokens[]
    mentions                   Mentions[]
    messageConversationKeys    MessageConversationKeys[]
    messageConversationMembers MessageConversationMembers[]
    messageIdentities          MessageIdentities?
    messages                   Messages[]
    passkeys                   Passkey[]
    passwordResetTokens        PasswordResetTokens[]
    postVisits                 PostVisits[]
    posts                      Posts[]
    pushSubscriptions          PushSubscriptions[]
    recommendationEvents       RecommendationEvents[]
    twoFactor                  TwoFactor[]
    usernameAliases            UsernameAliases[]
    verifications              Verification[]
    votes                      Votes[]
    auraLogs                   AuraLogs[]                   @relation(name: "aura_logs_issuerId_fkey")
    auraLogsAuraLogs           AuraLogs[]                   @relation(name: "aura_logs_userId_fkey")
    blocks                     Blocks[]                     @relation(name: "blocks_blockedId_fkey")
    blocksBlocks               Blocks[]                     @relation(name: "blocks_blockerId_fkey")
    follows                    Follows[]                    @relation(name: "follows_followerId_fkey")
    followsFollows             Follows[]                    @relation(name: "follows_followingId_fkey")
    notifications              Notifications[]              @relation(name: "notifications_issuerId_fkey")
    notificationsNotifications Notifications[]              @relation(name: "notifications_recipientId_fkey")
    sessions                   Sessions[]                   @relation(name: "sessions_impersonatedBy_fkey")
    sessionsSessions           Sessions[]                   @relation(name: "sessions_userId_fkey")
    avatarMedia                PostMedia?                   @relation(name: "users_avatarMediaId_fkey", fields:[avatarMediaId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "users_avatarMediaId_fkey")
    bannerMedia                PostMedia?                   @relation(name: "users_bannerMediaId_fkey", fields:[bannerMediaId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "users_bannerMediaId_fkey")

    @@index([role], name: "users_admin_role_unique", where: "(role = 'admin'::text)", unique: true)
    @@index([aura], map: "users_aura_idx")
    @@index(expression: "(\nCASE\n    WHEN 'author'::text = ANY (badges) THEN 'author'::text\n    ELSE NULL::text\nEND)", name: "users_author_array_unique", unique: true)
    @@index([badge], name: "users_author_badge_unique", where: "(badge = 'author'::text)", unique: true)
    @@unique([avatarMediaId], map: "users_avatarMediaId_key")
    @@index([badges], map: "users_badges_idx", type: "gin")
    @@index([banExpires], map: "users_banExpires_idx")
    @@index([banned], map: "users_banned_idx")
    @@unique([bannerMediaId], map: "users_bannerMediaId_key")
    @@unique([discordId], map: "users_discordId_key")
    @@index(expression: "\"displayName\" gin_trgm_ops", name: "users_display_name_trgm_idx", type: "gin")
    @@index(expression: "\"displayUsername\" gin_trgm_ops", name: "users_display_username_trgm_idx", type: "gin")
    @@unique([email], map: "users_email_key")
    @@unique([githubId], map: "users_githubId_key")
    @@unique([googleId], map: "users_googleId_key")
    @@unique([redditId], map: "users_redditId_key")
    @@unique([twitterId], map: "users_twitterId_key")
    @@unique([username], map: "users_username_key")
    @@index(expression: "username gin_trgm_ops", name: "users_username_trgm_idx", type: "gin")
    @@index(expression: "lower(username)", name: "users_username_lower_unique", unique: true)
    @@map("users")
  }

  model Accounts {
    id                    String        @id(map: "accounts_pkey") @default(uuid())
    userId                String
    accountId             String
    providerId            String
    issuer                String        @default("")
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  Timestamp(3)?
    refreshTokenExpiresAt Timestamp(3)?
    scope                 String?
    idToken               String?
    password              String?
    createdAt             Timestamp(3)  @default(now())
    updatedAt             Timestamp(3)  @default(now())
    user                  Users         @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "accounts_userId_fkey", index: false)

    @@index([issuer, accountId], map: "accounts_issuer_accountId_idx")
    @@unique([providerId, accountId], map: "accounts_providerId_accountId_key")
    @@map("accounts")
  }

  model AuraLogs {
    id           String            @id(map: "aura_logs_pkey") @default(uuid())
    userId       String
    issuerId     String
    amount       Int
    _type        pg.enum(AuraType) @map("type")
    postId       String?
    commentId    String?
    targetUserId String?
    createdAt    Timestamp(3)      @default(now())
    comment      Comments?         @relation(fields:[commentId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "aura_logs_commentId_fkey", index: false)
    issuer       Users             @relation(name: "aura_logs_issuerId_fkey", fields:[issuerId], references:[id], onDelete: Restrict, onUpdate: Cascade, map: "aura_logs_issuerId_fkey", index: false)
    post         Posts?            @relation(fields:[postId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "aura_logs_postId_fkey", index: false)
    user         Users             @relation(name: "aura_logs_userId_fkey", fields:[userId], references:[id], onDelete: Restrict, onUpdate: Cascade, map: "aura_logs_userId_fkey", index: false)

    @@index([issuerId, targetUserId, createdAt], map: "aura_logs_issuerId_targetUserId_createdAt_idx")
    @@index([userId, createdAt], map: "aura_logs_userId_createdAt_idx")
    @@map("aura_logs")
  }

  model Blocks {
    blockerId String
    blockedId String
    createdAt Timestamp(3) @default(now())
    blocked   Users        @relation(name: "blocks_blockedId_fkey", fields:[blockedId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "blocks_blockedId_fkey")
    blocker   Users        @relation(name: "blocks_blockerId_fkey", fields:[blockerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "blocks_blockerId_fkey", index: false)

    @@id([blockerId, blockedId], map: "blocks_pkey")
    @@index([blockedId], map: "blocks_blockedId_idx")
    @@map("blocks")
  }

  model Bookmarks {
    id             String       @id(map: "bookmarks_pkey") @default(uuid())
    userId         String
    postId         String
    bookmarkerAura Int          @default(0)
    authorAura     Int          @default(0)
    createdAt      Timestamp(3) @default(now())
    post           Posts        @relation(fields:[postId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "bookmarks_postId_fkey")
    user           Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "bookmarks_userId_fkey", index: false)

    @@index([postId], map: "bookmarks_postId_idx")
    @@index([userId, createdAt], map: "bookmarks_userId_createdAt_idx")
    @@unique([userId, postId], map: "bookmarks_userId_postId_key")
    @@map("bookmarks")
  }

  model CommentVotes {
    userId         String
    commentId      String
    value          Int
    awardedAura    Int          @default(0)
    mutingCostAura Int          @default(0)
    createdAt      Timestamp(3) @default(now())
    comment        Comments     @relation(fields:[commentId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "comment_votes_commentId_fkey", index: false)
    user           Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "comment_votes_userId_fkey", index: false)

    @@index([commentId, value], map: "comment_votes_commentId_value_idx")
    @@id([userId, commentId], map: "comment_votes_pkey")
    @@map("comment_votes")
  }

  model CommunityJoinBonuses {
    id          String       @id(map: "community_join_bonuses_pkey") @default(uuid())
    communityId String
    userId      String
    joinerAura  Int
    ownerAura   Int
    createdAt   Timestamp(3) @default(now())
    community   Communities  @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_join_bonuses_communityId_fkey", index: false)
    user        Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_join_bonuses_userId_fkey", index: false)

    @@unique([communityId, userId], map: "community_join_bonuses_communityId_userId_key")
    @@index([userId, createdAt], map: "community_join_bonuses_userId_createdAt_idx")
    @@map("community_join_bonuses")
  }

  model CommunityMembers {
    id          String                         @id(map: "community_members_pkey") @default(uuid())
    communityId String
    userId      String
    role        pg.enum(CommunityRole)         @default("PARTICIPANT")
    status      pg.enum(CommunityMemberStatus) @default("ACTIVE")
    createdAt   Timestamp(3)                   @default(now())
    community   Communities                    @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_members_communityId_fkey", index: false)
    user        Users                          @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_members_userId_fkey")

    @@index([communityId, role], map: "community_members_communityId_role_idx")
    @@index([communityId, status], map: "community_members_communityId_status_idx")
    @@unique([communityId, userId], map: "community_members_communityId_userId_key")
    @@index([userId], map: "community_members_userId_idx")
    @@index([userId, status, createdAt], map: "community_members_userId_status_createdAt_idx")
    @@map("community_members")
  }

  model CommunityPostShares {
    id           String       @id(map: "community_post_shares_pkey") @default(uuid())
    postId       String
    sourcePostId String
    communityId  String
    createdAt    Timestamp(3) @default(now())
    community    Communities  @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_post_shares_communityId_fkey")
    post         Posts        @relation(name: "community_post_shares_postId_fkey", fields:[postId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_post_shares_postId_fkey")
    sourcePost   Posts        @relation(name: "community_post_shares_sourcePostId_fkey", fields:[sourcePostId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_post_shares_sourcePostId_fkey")

    @@index([communityId], map: "community_post_shares_communityId_idx")
    @@unique([postId], map: "community_post_shares_postId_key")
    @@index([sourcePostId], map: "community_post_shares_sourcePostId_idx")
    @@map("community_post_shares")
  }

  model CommunitySubscriptions {
    id          String       @id(map: "community_subscriptions_pkey") @default(uuid())
    communityId String
    userId      String
    createdAt   Timestamp(3) @default(now())
    community   Communities  @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_subscriptions_communityId_fkey")
    user        Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_subscriptions_userId_fkey", index: false)

    @@index([communityId], map: "community_subscriptions_communityId_idx")
    @@unique([communityId, userId], map: "community_subscriptions_communityId_userId_key")
    @@index([userId, createdAt], map: "community_subscriptions_userId_createdAt_idx")
    @@map("community_subscriptions")
  }

  model CommunityVisits {
    id          String       @id(map: "community_visits_pkey") @default(uuid())
    communityId String
    userId      String
    visitedAt   Timestamp(3) @default(now())
    community   Communities  @relation(fields:[communityId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_visits_communityId_fkey", index: false)
    user        Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "community_visits_userId_fkey", index: false)

    @@unique([communityId, userId], map: "community_visits_communityId_userId_key")
    @@index([communityId, visitedAt], map: "community_visits_communityId_visitedAt_idx")
    @@index([userId, visitedAt], map: "community_visits_userId_visitedAt_idx")
    @@map("community_visits")
  }

  model DevicePushTokens {
    id        String       @id(map: "device_push_tokens_pkey") @default(uuid())
    userId    String
    token     String
    provider  String       @default("fcm")
    platform  String
    createdAt Timestamp(3) @default(now())
    updatedAt Timestamp(3) @default(now())
    user      Users        @relation(fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "device_push_tokens_userId_fkey")

