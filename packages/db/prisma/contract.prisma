  // What a durable membership log line can record. One value per mutation the
  // transcript draws, so a new mutation that wants a line is a compile error here
  // rather than a string that silently renders as nothing.
  native_enum DenMembershipEventAction {
    CREATED = "CREATED"
    JOINED = "JOINED"
    LEFT = "LEFT"
    REMOVED = "REMOVED"
    PROMOTED = "PROMOTED"
    DEMOTED = "DEMOTED"
    OWNER_TRANSFERRED = "OWNER_TRANSFERRED"
  }

  // Who may put this account in a group conversation without being asked first.
  //
  // `FOLLOWING_ONLY` is named for the direction it means rather than the word
  // "followers", because the two are opposites here: it qualifies an adder the
  // candidate already follows, not somebody who follows the candidate. The
  // setting is the candidate's own list, so the naming has to say whose list.
  native_enum GroupAddPolicy {
    // Anybody at all.
    EVERYONE = "EVERYONE"
    // Only the people this account already follows.
    FOLLOWING_ONLY = "FOLLOWING_ONLY"
    // Nobody. An invite link still works, because joining is the account's own
    // decision and a link is how they are asked.
    NO_DIRECT_ADDS = "NO_DIRECT_ADDS"
  }

  native_enum MediaStatus {
    UPLOADING = "UPLOADING"
    QUARANTINED = "QUARANTINED"
    SCANNING = "SCANNING"
    PROCESSING = "PROCESSING"
    READY = "READY"
    FAILED = "FAILED"
    REJECTED = "REJECTED"
    DELETED = "DELETED"
  }

  native_enum MediaType {
    IMAGE = "IMAGE"
    VIDEO = "VIDEO"
    AUDIO = "AUDIO"
    DOCUMENT = "DOCUMENT"
  }

  native_enum MediaVisibility {
    PUBLIC = "PUBLIC"
    UNLISTED = "UNLISTED"
    PRIVATE = "PRIVATE"
  }

  native_enum NotificationType {
    AMPLIFY = "AMPLIFY"
    FOLLOW = "FOLLOW"
    COMMENT = "COMMENT"
    MENTION = "MENTION"
    MODERATION = "MODERATION"
    PUBLISHED = "PUBLISHED"
    TRANSCRIPTION = "TRANSCRIPTION"
    REPLY = "REPLY"
    COMMUNITY_POST = "COMMUNITY_POST"
    DEN_MESSAGE = "DEN_MESSAGE"
    // A den membership ended without the recipient's consent: they were removed,
    // or the owner dissolved the den. The only den event a member cannot
    // discover by looking at the app, because both leave a den that is either
    // gone or closed to them. Carries no conversationId: a dissolved den's row
    // cascades the foreign key away, and a removed member is not a member, so
    // there is no address the row could honestly point at.
    DEN_MEMBERSHIP_ENDED = "DEN_MEMBERSHIP_ENDED"
  }

  native_enum RejectionReason {
    MALWARE = "MALWARE"
    MIME_MISMATCH = "MIME_MISMATCH"
    UNSUPPORTED_TYPE = "UNSUPPORTED_TYPE"
    TOO_LARGE = "TOO_LARGE"
    TOO_LONG = "TOO_LONG"
    CORRUPT = "CORRUPT"
    POLICY = "POLICY"
  }
