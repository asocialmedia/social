  model MessageConversationInviteCodes {
    // A join code a den has retired, kept so that a link or short code which
    // no longer joins can still identify the den it used to open.
    //
    // Holds both kinds of retired join codes: 12-character link codes and
    // 6-character short codes. Lengths (6 vs 12) are disjoint so primary keys
    // can never collide across kinds. Live-column-first lookup keeps a live
    // code beating an archive row. Shared retention window of 5 per den.
    //
    // Rotating a den's code overwrote `message_conversations.inviteCode` (or
    // `inviteShortCode`), which meant a link or code that had already been
    // shared stopped resolving with no trace at all. The person holding it got
    // one dead end - "this link is not valid" - and no way to learn which den had
    // retired the code or who to ask for a new one. This table is the fix, and
    // it exists for exactly that: a code is written here in the SAME transaction
    // that replaces it on the conversation row, so a rotation cannot commit
    // without archiving the code it invalidated.
    //
    // What it must NOT be used for:
    //
    //   - As a way back in. A retired code grants nothing. `joinDenByInviteCode`
    //     resolves against the live column alone and never reads this table, so an
    //     archived code can never be replayed into a membership row. The archive
    //     identifies a den; it never admits to one.
    //
    //   - As a validity oracle for guessing. Reading this table IS a disclosure:
    //     a code found here answers with the den's id, name, member count and
    //     owner. That trade is deliberate and bounded - see the decision above
    //     `previewRetiredInvite` - but it is the reason nothing here may ever grow
    //     past those four facts. A roster, a join log, or a message count would
    //     turn this into a history of a room that people have since left.
    //
    //   - As an audit log. There is no "who retired it" column, on purpose.
    //     Rotation is already gated on den management, the archived string grants
    //     nothing the moment it is retired, and the den's live `ownerId` stays the
    //     authority on who to ask - an actor snapshot here would go stale on every
    //     ownership transfer and on every account deletion, and no query would ever
    //     read it. A column nothing reads is a column that leaks.
    //
    // Retention is bounded per den by `DEN_LIMITS.retiredInviteCodeMax`, pruned by
    // the same rotation that wrote the row. Unbounded this is a slow-motion leak of
    // secrets that no longer open anything, growing with how often somebody presses
    // a button rather than with how many people use the product.
    code           String
    // The den this code used to open. Cascade, and that is the whole answer for a
    // dissolved den: its codes go with it, so a link to a room that no longer
    // exists reads as a link that never resolved, rather than as a link to a den
    // whose owner has vanished and whose messages are unreadable.
    conversationId String
    // When the code stopped working. Read only to order the prune, newest first,
    // so a den keeps its most recent codes and drops older ones. Never returned to
    // a reader and never used to authorise anything: an archived code is dead
    // whether it was retired a second ago or a year ago.
    retiredAt      Timestamp(3)
    conversation   MessageConversations @relation(fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_invite_codes_conversationId_fkey", index: false)

    // The primary key rather than a surrogate id with a unique beside it, because
    // the code IS this row's identity and there is nothing else to look one up by.
    //
    // It is NOT unique against the two live columns, which are in a different
    // table, so a code can in principle be current on one den and archived from
    // another. The mint-time archive probe makes that state near-impossible for
    // both namespaces (a rotation archives only the code it is replacing, and
    // never adopts an archived value), and the lookup answers the residue anyway
    // by reading the live columns first, so a live code always beats an archive
    // row naming some other den. This table holds BOTH namespaces - retired
    // 12-character links and retired 6-character short codes - under one shared
    // per-den retention budget.
    @@id([code], map: "message_conversation_invite_codes_pkey")
    // Serves the prune, which is the only query that reads this table by
    // conversation: it asks for one den's newest archived codes. The join screen's
    // own lookup is by `code`, which the primary key above already answers with a
    // single index probe.
    @@index([conversationId, retiredAt], map: "message_conversation_invite_codes_conversationId_retiredAt_idx")
    @@map("message_conversation_invite_codes")
  }

  model MessageDenBans {
    // Somebody who cannot come back to a den, however they arrive.
    //
    // This is the table that separates "remove" from "ban". A removal stamps
    // `leftAt` on the membership row and stops access from now on, but it grants
    // nothing about the future: a removed person can walk back in with a live
    // invite link, which is correct for somebody who was removed and correct for
    // somebody who left voluntarily, and useless for somebody who was removed on
    // purpose. A ban is the answer to the second case, and it has to be its own
    // row rather than a flag on the membership because the two facts are
    // independent: a ban outlives the departure (there may not BE a membership row
    // at the moment it is applied), and a departure outlives nothing.
    //
    // Deliberately NOT inferred from the membership log. `REMOVED` says a manager
    // took somebody out; it does not say they were never allowed back, and
    // retroactively banning every removed member would lock out people a manager
    // expects to return. A ban is only ever written by an explicit ban action.
    conversationId String
    userId          String
    // Who imposed it. SetNull rather than Cascade: deleting the account of an
    // Elder who banned somebody must not delete the ban and quietly let them back
    // into a room they were kept out of on purpose.
    bannedById      String?
    // Why, in the moderator's own words. Manager-only and never shown to the
    // banned person, so it is a note to the next manager rather than a sentence
    // somebody has to answer for. Nullable, because a ban does not require a
    // reason and a mandatory field is a reason people stop using the control.
    reason          String?
    createdAt       Timestamp(3)                 @default(now())
    conversation    MessageConversations @relation(name: "message_den_bans_conversationId_fkey", fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_den_bans_conversationId_fkey", index: false)
    user            Users                @relation(name: "message_den_bans_userId_fkey", fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_den_bans_userId_fkey", index: false)
    bannedBy        Users?               @relation(name: "message_den_bans_bannedById_fkey", fields:[bannedById], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "message_den_bans_bannedById_fkey", index: false)

    // One row per person per den, which is the whole identity of the fact: a ban is
    // a set membership, not a log. Unbanning deletes the row rather than stamping it,
    // so there is no "was banned once" state to consult at the door - and no way for
    // the door to be wrong because an expiry was misread.
    @@id([conversationId, userId], map: "message_den_bans_pkey")
    // The manager-facing list is "this den's bans, newest first", which is a range
    // scan on this index.
    @@index([conversationId, createdAt], map: "mdb_conversationId_createdAt_idx")
    // "What has this account been kept out of", for a ban count on a profile and for
    // the sweep that would answer it.
    @@index([userId], map: "mdb_userId_idx")
    @@map("message_den_bans")
  }

  model MessageConversationMembershipEvents {
    // A durable log line for the transcript: somebody joined, left, was removed,
    // or their role moved.
    //
    // Role changes used to overwrite the membership row and departures deleted it,
    // so neither left a trace, and a chat that showed no history of who came and
    // went was missing the context that makes a room make sense. This table is that
    // trace.
    //
    // Name columns are SNAPSHOTS, deliberately, and there is no foreign key to
    // Users. A membership log has to outlive the membership and the account: the
    // person who left is not on the roster any more, so a join through the live
    // roster would find nobody and the line would read "Unknown left". Snapshotting
    // the name at write time is what keeps "Ada removed Bob" readable after Bob's
    // account is gone, and no FK means an account deletion cannot cascade the
    // history away with it.
    //
    // `actorId`/`targetUserId` are kept alongside the snapshots so a client can mark
    // the reader's own actions ("You removed Bob") and so a future feature can key
    // on a stable id, but nothing joins on them.
    id             String                    @id(map: "message_conversation_membership_events_pkey") @default(uuid())
    conversationId String
    // Who did it. Null only for a row with no single actor, which does not exist
    // yet: creation names the creator, and every subsequent line names the manager
    // or the person acting on themselves.
    actorId        String?
    actorName      String?
    // Who it happened to, when that is somebody other than the actor. Null for a
    // join or a leave, where the actor is the subject.
    targetUserId   String?
    targetName     String?
    action         pg.enum(DenMembershipEventAction)
    createdAt      Timestamp(3)              @default(now())
    // Cascade is the whole answer for a dissolved den: its history goes with it, as
    // its messages do, so a deleted den leaves nothing behind.
    conversation   MessageConversations      @relation(fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_membership_events_conversationId_fkey", index: false)

    // The only query is "this den's log, oldest first", which this answers.
    @@index([conversationId, createdAt], map: "mcme_conversationId_createdAt_idx")
    @@map("message_conversation_membership_events")
  }

  model MessageConversationKeys {
    id             String               @id(map: "message_conversation_keys_pkey") @default(uuid())
    conversationId String
    ownerUserId    String
    // The member who performed the wrap. SetNull, not Cascade: the wrap stays
    // readable by the members it was made for even after the wrapper leaves, and
    // dropping the row on their account deletion would silently erase a root-key
    // epoch from everyone else's history.
    wrapper        Users?                @relation(name: "message_conversation_keys_wrapperUserId_fkey", fields:[wrapperUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "message_conversation_keys_wrapperUserId_fkey")
    encryptedKey   String
    iv             String
    version        Int                  @default(1)
    // Which member performed the ECDH wrap for this row. NULL on every DM row
    // written before this column existed, where the wrapper is unambiguously the
    // single peer.
    wrapperUserId  String?
    // The wrapper's identity public key, snapshotted at wrap time. Public key
    // material, so storing it reveals nothing the identity row does not. It is
    // denormalized deliberately: a member who leaves the den is still the
    // wrapper for epochs the remaining members must keep reading, so resolving
    // the wrapper through the live roster would strand those epochs.
    wrapperPublicKey String?
    ratchetCounter Int                  @default(0)
    createdAt      Timestamp(3)         @default(now())
    conversation   MessageConversations @relation(fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_keys_conversationId_fkey", index: false)
    ownerUser      Users                @relation(name: "message_conversation_keys_ownerUserId_fkey", fields:[ownerUserId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_keys_ownerUserId_fkey", index: false)

    @@unique([conversationId, ownerUserId, version], map: "message_conversation_keys_conversationId_ownerUserId_versio_key")
    @@index([conversationId, ownerUserId], map: "message_conversation_keys_conversationId_ownerUserId_idx")
    @@index([wrapperUserId], map: "message_conversation_keys_wrapperUserId_idx")
    @@map("message_conversation_keys")
  }

  model MessageConversationMembers {
    conversationId  String
    userId          String
    // Den-only. A DM row carries MEMBER, which is never read: the DM gates are
    // membership, not role, so existing rows need no data transform to become
    // valid den rows.
    role            pg.enum(DenRole)    @default("MEMBER")
    // Den-only provenance: who added this member. NULL when the member was the
    // creator, or joined through an invite link with no single referrer.
    invitedById     String?
    // Den-only, and the one column that decides read from write. NULL is the only
    // state that can act in the den: set on leave or removal, and cleared again if
    // the person rejoins through an invite.
    //
    // The row is kept rather than deleted so the den stays in the person's message
    // list and its history stays readable, up to the moment they left. Nothing after
    // `leftAt` is theirs to read: it never reaches their device, because the key
    // fan-out and the stream both enumerate members with this column still NULL.
    //
    // Den rows only. A DM row carries NULL forever, so every filter here is a no-op
    // for DMs and none of the DM gates need to know this column exists.
    leftAt          Timestamp(3)?
    lastReadAt      Timestamp(3)?
    // Null until the member marks the thread read after sequence cursors are deployed.
    lastReadSequence Int?
    // Null until the durable backfill worker has reconciled this member's unread
    // state. A null counter always falls back to the indexed unread aggregate.
    unreadCount     Int?
    lastDeliveredAt Timestamp(3)?
    mutedAt         Timestamp(3)?
    themeKey        String?
    wallpaperKey    String?
    wallpaperDim    Int?
    wallpaperMediaId String?
    createdAt       Timestamp(3)         @default(now())
    conversation    MessageConversations @relation(fields:[conversationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_members_conversationId_fkey", index: false)
    user            Users                @relation(name: "message_conversation_members_userId_fkey", fields:[userId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "message_conversation_members_userId_fkey")
    // SetNull, not Cascade: deleting the account that added somebody must not
    // delete that somebody's membership.
    invitedBy      Users?               @relation(name: "message_conversation_members_invitedById_fkey", fields:[invitedById], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "message_conversation_members_invitedById_fkey")
    wallpaperMedia  PostMedia?           @relation(name: "message_conversation_members_wallpaperMediaId_fkey", fields:[wallpaperMediaId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "message_conversation_members_wallpaperMediaId_fkey")

    @@id([conversationId, userId], map: "message_conversation_members_pkey")
    @@index([userId], map: "message_conversation_members_userId_idx")
    @@index([userId, mutedAt], map: "message_conversation_members_userId_mutedAt_idx")
    @@index([unreadCount], map: "message_conversation_members_unread_count_idx")
    @@index([invitedById], map: "message_conversation_members_invitedById_idx")
    @@index([conversationId, role], map: "message_conversation_members_conversationId_role_idx")
    @@unique([wallpaperMediaId], map: "message_conversation_members_wallpaperMediaId_key")
    @@map("message_conversation_members")
  }

