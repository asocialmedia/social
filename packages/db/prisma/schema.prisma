generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  aura             Int       @default(0)
  username         String    @unique
  displayName      String
  displayUsername  String?
  email            String?   @unique
  passwordHash     String?
  googleId         String?   @unique
  githubId         String?   @unique
  discordId        String?   @unique
  twitterId        String?   @unique
  redditId         String?   @unique
  avatarUrl        String?
  avatarKey        String?
  avatarMediaId    String?   @unique
  avatarMedia      Media?    @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerUrl        String?
  bannerKey        String?
  bio              String?
  githubUsername   String?
  linkedinUsername String?
  twitterUsername  String?
  redditUsername   String?
  customDomain     String?
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  image            String?
  name             String?
  role             String    @default("user")
  badge            String?
  badges           String[]  @default([])
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?

  sessions              Session[]
  accounts              Account[]
  verifications         Verification[]
  passwordResetTokens   PasswordResetToken[]
  mentions              Mention[]
  posts                 Post[]
  following             Follow[]                    @relation("Following")
  followers             Follow[]                    @relation("Followers")
  bookmarks             Bookmark[]
  comments              Comment[]
  vote                  Vote[]
  commentVotes          CommentVote[]
  receivedNotifications Notification[]              @relation("Recipient")
  issuedNotifications   Notification[]              @relation("Issuer")
  hnbookmark            HNBookmark[]
  postVisits            PostVisit[]
  auraReceived          AuraLog[]                   @relation("AuraReceived")
  auraIssued            AuraLog[]                   @relation("AuraIssued")
  impersonatedSessions  Session[]                   @relation("ImpersonatedSessions")
  messageIdentity       MessageIdentity?
  messageMemberships    MessageConversationMember[]
  messageKeys           MessageConversationKey[]
  messagesSent          Message[]
  blocksIssued          Block[]                     @relation("BlocksIssued")
  blocksReceived        Block[]                     @relation("BlocksReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aura])
  @@index([banned])
  @@index([banExpires])
  @@map("users")
}

// E2EE messages. The server only ever stores ciphertext plus routing metadata;
// the plaintext (and any referenced post id) lives inside the AES-GCM payload.
// The private identity key is backed up on the server encrypted under a
// PBKDF2-derived master key so the owner can recover old chats on a new
// device, while the server never learns the secret.
model MessageIdentity {
  userId              String   @id
  publicKey           String
  encryptedPrivateKey String
  // SHA-256 hex hash of the account's random 64-char backup secret. This is
  // a VERIFIER only: it proves knowledge of the secret but cannot yield the
  // master key, because the master key derives (PBKDF2) from the raw secret,
  // which lives exclusively on the user's devices. A database reader holding
  // this row therefore cannot decrypt encryptedPrivateKey. Rows created by
  // older clients derived the master key from this hash directly; those
  // legacy rows remain decryptable until the identity is re-provisioned.
  // Optional only to tolerate such legacy rows.
  masterKeyHash       String?
  salt                String
  kdfIterations       Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("message_identities")
}

model MessageConversation {
  id        String                      @id @default(cuid())
  // Deterministic key for a two-member thread: the two user ids joined in
  // sorted order. Unique so concurrent "start a chat" requests for the same
  // pair resolve to one conversation instead of racing into two. Nullable so
  // rows created before this column existed keep their place until rewritten.
  pairKey   String?                     @unique
  members   MessageConversationMember[]
  keys      MessageConversationKey[]
  messages  Message[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@map("message_conversations")
}

model MessageConversationMember {
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime            @default(now())

  @@id([conversationId, userId])
  @@index([userId])
  @@map("message_conversation_members")
}

// The per-conversation symmetric key, wrapped separately for each participant
// via ECDH + HKDF so nobody but the two members can unwrap it. The counter
// tracks the symmetric ratchet for this participant's decryption chain.
model MessageConversationKey {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerUserId    String
  ownerUser      User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  encryptedKey   String
  iv             String
  ratchetCounter Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@unique([conversationId, ownerUserId])
  @@map("message_conversation_keys")
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ciphertext     String
  iv             String
  // Position of this message within the sender's chain in this conversation.
  // The receiver derives the same message key from the root convo key plus
  // (senderId, ratchetIndex), so decryption works deterministically on any
  // device without any client-side chain state.
  ratchetIndex   Int                 @default(0)
  createdAt      DateTime            @default(now())
  deletedAt      DateTime?

  // A sender may never emit two messages at the same ratchet position. The
  // server hands out indexes from an atomic counter, so this is the last line
  // of defense against a concurrent duplicate send racing the counter read.
  @@unique([conversationId, senderId, ratchetIndex])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// A block is bidirectional in practice: either party can block, and the pair
// can never message again until both unblock. Messaging is the only consumer
// of Block in v1.
model Block {
  blockerId String
  blocker   User     @relation("BlocksIssued", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model AuraLog {
  id           String   @id @default(cuid())
  userId       String
  issuerId     String
  amount       Int
  type         AuraType
  postId       String?
  commentId    String?
  // Recipient of the underlying action (post author, followed user, ...),
  // denormalized so pair-based anti-farm queries (tapering repeat
  // interactions between the same two accounts) and audits do not need joins.
  // Nullable because rows written before this column existed have no value;
  // the aura engine treats null as "legacy row" and falls back to
  // content-id-scoped lookups instead of pair-scoped ones.
  targetUserId String?
  createdAt    DateTime @default(now())

  user    User     @relation("AuraReceived", fields: [userId], references: [id])
  issuer  User     @relation("AuraIssued", fields: [issuerId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  @@index([userId, createdAt])
  @@index([issuerId, targetUserId, createdAt])
  @@map("aura_logs")
}

enum AuraType {
  POST_CREATION
  POST_ATTACHMENT_BONUS
  POST_VOTE
  POST_VOTE_REMOVED
  POST_VIEWS_MILESTONE
  COMMENT_CREATION
  COMMENT_RECEIVED
  COMMENT_VOTE
  COMMENT_VOTE_REMOVED
  FOLLOW_GAINED
  FOLLOW_GIVEN
  POST_BOOKMARKED
  POST_BOOKMARK_RECEIVED
  MODERATION_PENALTY
  // Cost charged to the muter when they mute (downvote) someone's content;
  // keeps muting honest by making mass-muting expensive. Reversals on un-mute
  // reuse this type with the opposite sign.
  MUTING_COST
  // Author award when a post's aggregate share count crosses a milestone.
  // Shares are tracked per platform without a per-user actor, so like view
  // milestones these are attributed to aggregate attention, not one account.
  SHARE_MILESTONE
  // Author bonus for sharing a story to Hacker News at creation time.
  HN_SHARE_BONUS
  // Award to a user for being mentioned in someone's post. Unique per
  // (post, mentioned user) by the Mention table.
  MENTION_RECEIVED
  // Flat daily award for appearing in the trending users card. Deduped per
  // user per UTC day upstream; issuer and recipient are both the awarded
  // user since the platform itself is the actor.
  TRENDING_APPEARANCE
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@map("password_reset_tokens")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin          User?    @relation("ImpersonatedSessions", fields: [impersonatedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String    @default("")
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([issuer, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification")
}

model Follow {
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  // Open aura positions: gainedAura is what the followed user earned from
  // this follow, givenAura is what the follower earned for it. Unfollowing
  // reverses exactly these amounts; zero defaults keep legacy follows inert
  // on removal (conservative under-refund).
  gainedAura Int @default(0)
  givenAura  Int @default(0)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Post {
  id                    String         @id @default(cuid())
  content               String
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aura                  Int            @default(0)
  viewCount             Int            @default(0)
  lastAwardedViewCount  Int            @default(0)
  // Highest share total already paid out for SHARE_MILESTONE aura. The
  // share-flush worker reads and advances it under a CAS so concurrent
  // flushes never double-award (see apps/auth/src/worker/share-flush.ts).
  lastAwardedShareCount Int            @default(0)
  trendingScore         Float          @default(0)
  isGust                Boolean        @default(false)
  moderated             Boolean        @default(false)
  explicitContent       Boolean        @default(false)
  attachments           Media[]
  bookmarks             Bookmark[]
  comments              Comment[]
  linkedNotifications   Notification[]
  vote                  Vote[]
  shareStats            ShareStats[]
  auraLogs              AuraLog[]
  tags                  Tag[]
  mentions              Mention[]
  hnStoryShare          HNStoryShare?
  visits                PostVisit[]

  createdAt DateTime @default(now())

  @@index([isGust, createdAt])
  @@index([isGust, aura, id])
  @@index([isGust, trendingScore, id])
  @@index([userId, isGust, createdAt])
  @@map("posts")
}

model PostVisit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, visitedAt])
  @@index([postId])
  @@map("post_visits")
}

// Ops bookkeeping for one-shot data backfills (guarded runs that must happen
// exactly once across a deployment fleet). The table is created and consumed
// by scripts/backfill-trending-scores.ts and docker/prisma-sync.sh; it is
// declared here with @@ignore purely so `prisma db push` never drops it as an
// unknown table. It intentionally emits no client types.
model BackfillMarker {
  name        String   @id
  completedAt DateTime @default(now()) @map("completed_at")

  @@map("backfill_markers")
  @@ignore
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Media {
  id                  String           @id @default(cuid())
  postId              String?
  post                Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId           String?
  comment             Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId              String?
  avatarOf            User?            @relation("UserAvatar")
  url                 String
  key                 String           @default("")
  mimeType            String           @default("application/octet-stream")
  // Coarse category written at upload initiation from the declared MIME
  // (mediaTypeFromMime) and consumed across serving surfaces. mimeType
  // stays the precise source of truth; this drives routing/UI switches.
  type                MediaType        @default(IMAGE)
  size                Int              @default(0)
  width               Int?
  height              Int?
  // Frame extracted at ~2s for video uploads; served via /api/media/{id}?thumb=1
  thumbnailKey        String?
  thumbnailWidth      Int?
  thumbnailHeight     Int?
  // True when the pipeline generated an adaptive HLS ladder for this video
  // (long-form or >1080p sources); clients use it to pick the streaming URL.
  hasHls              Boolean          @default(false)
  createdAt           DateTime         @default(now())
  // Legacy rows keep status UPLOADING with a legacy `key`; the serving route
  // falls back to legacy columns whenever no derivatives exist, so old posts
  // never break. New uploads always walk the state machine.
  status              MediaStatus      @default(UPLOADING)
  visibility          MediaVisibility  @default(PUBLIC)
  originalKey         String?
  publishedKey        String?
  claimedMime         String?
  detectedMime        String?
  originalName        String?
  sha256              String?
  phash               String?
  rejectedReason      RejectionReason?
  failureCode         String?
  failureDetail       Json?
  attempts            Int              @default(0)
  techMetadata        Json?
  exifStripped        Boolean          @default(false)
  altText             String?
  generatedAltText    String?
  safety              Json?
  semantics           Json?
  // Content provenance (C2PA): AI-generation classification recorded by the
  // scan stage. Null means never inspected (legacy/pre-pipeline rows). The
  // row flag is authoritative - embedded manifests can be stripped, this
  // cannot, and it survives re-uploads of the same media id.
  aiGenerated         Boolean?
  aiProvenance        Json?
  pipelineVersion     String?
  processedAt         DateTime?
  // Default(now()) lets db push backfill existing rows instead of refusing
  // the migration; @updatedAt keeps Prisma refreshing it on every write.
  updatedAt           DateTime         @default(now()) @updatedAt
  // ThumbHash LQIP data URL (~500 bytes) inlined into API responses.
  blurDataUrl         String?
  // Authoritative record attached by the scan stage at publish time. This
  // lives in the database ON PURPOSE: provenance embedded in binary files
  // can be stripped by any re-upload, while this record survives and keeps
  // answering "who posted what, when, through which pipeline version".
  // Identifies the platform that processed and serves this media.
  platform            String           @default("asocialmedia.cc")
  // Author display name snapshot taken when the media was published, so
  // attribution survives later profile renames.
  uploaderDisplayName String?
  // Encoder implementation version (MEDIA_ENCODER_VERSION) that produced
  // the derivatives, distinct from the pipeline logic version above.
  encoderVersion      String?
  // Exact-duplicate signal: id of an earlier media row whose published
  // bytes carry the same SHA-256. Detection signal only - never treated
  // as proof of ownership.
  duplicateOf         String?

  derivatives MediaDerivative[]

  @@index([commentId])
  @@index([status])
  @@index([sha256])
  @@index([duplicateOf])
  @@index([postId])
  @@index([userId, createdAt])
  @@map("post_media")
}

model MediaDerivative {
  id              String   @id @default(cuid())
  mediaId         String
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind            String
  variant         String   @default("default")
  key             String
  mimeType        String
  width           Int?
  height          Int?
  sizeBytes       Int?
  durationMs      Int?
  pipelineVersion String
  createdAt       DateTime @default(now())

  @@unique([mediaId, kind, variant])
  @@index([key])
  @@map("post_media_derivatives")
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  PROCESSING
  READY
  FAILED
  REJECTED
  DELETED
}

enum RejectionReason {
  MALWARE
  MIME_MISMATCH
  UNSUPPORTED_TYPE
  TOO_LARGE
  TOO_LONG
  CORRUPT
  POLICY
}

enum MediaVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Vote {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  value          Int
  // Open aura positions created by this vote, so removal reverses EXACTLY
  // what was awarded even when weighting/tapering made amounts vary.
  // awardedAura: net author-side aura currently applied by this vote.
  // mutingCostAura: muter honesty cost currently charged for this vote.
  // Zero defaults mean legacy votes (created before the economy shipped)
  // have nothing open to reverse - conservative: un-voting never charges.
  awardedAura    Int      @default(0)
  mutingCostAura Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, value, createdAt])
  @@map("votes")
}

model CommentVote {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value          Int
  // Open aura positions, mirroring Vote.awardedAura / Vote.mutingCostAura.
  awardedAura    Int      @default(0)
  mutingCostAura Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId, value])
  @@map("comment_votes")
}

model Bookmark {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Open aura positions: bookmarkerAura is what the bookmarker earned for
  // curating, authorAura is what the post author earned. Un-bookmarking
  // reverses exactly these amounts. Zero defaults keep legacy bookmarks
  // (pre-economy) inert on removal - conservative under-refund.
  bookmarkerAura Int @default(0)
  authorAura     Int @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model HNBookmark {
  id        String   @id @default(cuid())
  userId    String
  storyId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, storyId])
  @@index([userId, createdAt])
  @@index([userId])
}

model HNStoryShare {
  id          String   @id @default(cuid())
  postId      String   @unique
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  storyId     Int
  title       String
  url         String?
  by          String
  time        Int
  score       Int
  descendants Int
  createdAt   DateTime @default(now())

  @@map("hn_story_shares")
}

model Comment {
  id               String         @id @default(cuid())
  content          String
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId           String
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  rootId           String?
  root             Comment?       @relation("CommentRoots", fields: [rootId], references: [id], onDelete: SetNull)
  replies          Comment[]      @relation("CommentReplies")
  rootComments     Comment[]      @relation("CommentRoots")
  aura             Int            @default(0)
  // Open aura positions from this comment's creation: creationAura is what
  // the commenter earned, receivedAura is what the parent/post author earned
  // as primary recipient, postReceivedAura is what the POST author earned
  // when this comment was a reply (the thread-cumulative award). Soft-delete
  // reverses exactly these; zero defaults keep legacy comments inert on
  // deletion (conservative under-refund).
  creationAura     Int            @default(0)
  receivedAura     Int            @default(0)
  postReceivedAura Int            @default(0)
  deleted          Boolean        @default(false)
  attachments      Media[]
  votes            CommentVote[]
  auraLogs         AuraLog[]
  notifications    Notification[]
  createdAt        DateTime       @default(now())

  @@index([postId, createdAt])
  @@index([postId, parentId])
  @@index([postId, rootId, createdAt])
  @@map("comments")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuerId    String
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type        NotificationType
  read        Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([commentId])
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  AMPLIFY
  FOLLOW
  COMMENT
  MENTION
  MODERATION
  PUBLISHED
}

model Mention {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("mentions")
}

model ShareStats {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  String
  shares    Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, platform])
  @@map("share_stats")
}

model jwks {
  id         String   @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
