generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                      @id @default(cuid())
  aura                  Int                         @default(0)
  username              String                      @unique
  displayName           String
  displayUsername       String?
  email                 String?                     @unique
  passwordHash          String?
  googleId              String?                     @unique
  githubId              String?                     @unique
  discordId             String?                     @unique
  twitterId             String?                     @unique
  redditId              String?                     @unique
  avatarUrl             String?
  avatarKey             String?
  avatarMediaId         String?                     @unique
  avatarMedia           Media?                      @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerUrl             String?
  bannerKey             String?
  bannerMediaId         String?                     @unique
  bannerMedia           Media?                      @relation("UserBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  bio                   String?
  githubUsername        String?
  linkedinUsername      String?
  twitterUsername       String?
  redditUsername        String?
  customDomain          String?
  emailVerified         Boolean                     @default(false)
  emailVerifiedAt       DateTime?
  twoFactorEnabled      Boolean                     @default(false)
  lastLoginMethod       String?
  image                 String?
  name                  String?
  role                  String                      @default("user")
  badge                 String?
  badges                String[]                    @default([])
  banned                Boolean                     @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  twoFactor             TwoFactor?
  passkeys              Passkey[]
  usernameAliases       UsernameAlias[]
  verifications         Verification[]
  passwordResetTokens   PasswordResetToken[]
  mentions              Mention[]
  posts                 Post[]
  following             Follow[]                    @relation("Following")
  followers             Follow[]                    @relation("Followers")
  bookmarks             Bookmark[]
  comments              Comment[]
  vote                  Vote[]
  commentVotes          CommentVote[]
  receivedNotifications Notification[]              @relation("Recipient")
  issuedNotifications   Notification[]              @relation("Issuer")
  hnbookmark            HNBookmark[]
  postVisits            PostVisit[]
  auraReceived          AuraLog[]                   @relation("AuraReceived")
  auraIssued            AuraLog[]                   @relation("AuraIssued")
  impersonatedSessions  Session[]                   @relation("ImpersonatedSessions")
  messageIdentity       MessageIdentity?
  messageMemberships    MessageConversationMember[]
  messageKeys           MessageConversationKey[]
  messagesSent          Message[]
  blocksIssued          Block[]                     @relation("BlocksIssued")
  blocksReceived        Block[]                     @relation("BlocksReceived")
  recommendationEvents  RecommendationEvent[]
  ownedCommunities      Community[]                 @relation("CommunityOwner")
  communityMemberships  CommunityMember[]
  communityVisits       CommunityVisit[]
  communityJoinBonuses  CommunityJoinBonus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aura])
  @@index([banned])
  @@index([banExpires])
  @@map("users")
}

model UsernameAlias {
  id        String   @id @default(cuid())
  username  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("username_aliases")
}

model MessageIdentity {
  userId              String   @id
  publicKey           String
  encryptedPrivateKey String
  masterKeyHash       String?
  salt                String
  kdfIterations       Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("message_identities")
}

model MessageConversation {
  id        String                      @id @default(cuid())
  pairKey   String?                     @unique
  members   MessageConversationMember[]
  keys      MessageConversationKey[]
  messages  Message[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@map("message_conversations")
}

model MessageConversationMember {
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime            @default(now())

  @@id([conversationId, userId])
  @@index([userId])
  @@map("message_conversation_members")
}

model MessageConversationKey {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerUserId    String
  ownerUser      User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  encryptedKey   String
  iv             String
  ratchetCounter Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@unique([conversationId, ownerUserId])
  @@map("message_conversation_keys")
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ciphertext     String
  iv             String
  ratchetIndex   Int                 @default(0)
  createdAt      DateTime            @default(now())
  deletedAt      DateTime?

  @@unique([conversationId, senderId, ratchetIndex])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Block {
  blockerId String
  blocker   User     @relation("BlocksIssued", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model AuraLog {
  id           String   @id @default(cuid())
  userId       String
  issuerId     String
  amount       Int
  type         AuraType
  postId       String?
  commentId    String?
  targetUserId String?
  createdAt    DateTime @default(now())
  user         User     @relation("AuraReceived", fields: [userId], references: [id])
  issuer       User     @relation("AuraIssued", fields: [issuerId], references: [id])
  post         Post?    @relation(fields: [postId], references: [id])
  comment      Comment? @relation(fields: [commentId], references: [id])

  @@index([userId, createdAt])
  @@index([issuerId, targetUserId, createdAt])
  @@map("aura_logs")
}

enum AuraType {
  POST_CREATION
  POST_ATTACHMENT_BONUS
  POST_VOTE
  POST_VOTE_REMOVED
  POST_VIEWS_MILESTONE
  COMMENT_CREATION
  COMMENT_RECEIVED
  COMMENT_VOTE
  COMMENT_VOTE_REMOVED
  FOLLOW_GAINED
  FOLLOW_GIVEN
  POST_BOOKMARKED
  POST_BOOKMARK_RECEIVED
  MODERATION_PENALTY
  MUTING_COST
  SHARE_MILESTONE
  HN_SHARE_BONUS
  MENTION_RECEIVED
  TRENDING_APPEARANCE
  COMMUNITY_CREATED
  COMMUNITY_JOIN
  COMMUNITY_JOIN_OWNER
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@map("password_reset_tokens")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  country        String?
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin          User?    @relation("ImpersonatedSessions", fields: [impersonatedBy], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String    @default("")
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([issuer, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([secret])
  @@map("twoFactor")
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

model Follow {
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  gainedAura  Int    @default(0)
  givenAura   Int    @default(0)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Post {
  id                    String                @id @default(cuid())
  content               String
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  aura                  Int                   @default(0)
  viewCount             Int                   @default(0)
  lastAwardedViewCount  Int                   @default(0)
  lastAwardedShareCount Int                   @default(0)
  trendingScore         Float                 @default(0)
  isGust                Boolean               @default(false)
  moderated             Boolean               @default(false)
  explicitContent       Boolean               @default(false)
  parentPostId          String?
  parentPost            Post?                 @relation("PostResponses", fields: [parentPostId], references: [id], onDelete: SetNull)
  responses             Post[]                @relation("PostResponses")
  rootPostId            String?
  threadTopId           String?
  attachments           Media[]
  bookmarks             Bookmark[]
  comments              Comment[]
  linkedNotifications   Notification[]
  vote                  Vote[]
  shareStats            ShareStats[]
  auraLogs              AuraLog[]
  tags                  Tag[]
  mentions              Mention[]
  hnStoryShare          HNStoryShare?
  communityId           String?
  community             Community?            @relation(fields: [communityId], references: [id], onDelete: SetNull)
  communityShare        CommunityPostShare?   @relation("CommunityPostShareTarget")
  communityShares       CommunityPostShare[]  @relation("CommunityPostShares")
  visits                PostVisit[]
  recommendationEvents  RecommendationEvent[]
  embeds                Json?
  semanticTags          String[]              @default([])
  embedding             Float[]               @default([])
  createdAt             DateTime              @default(now())

  @@index([isGust, createdAt])
  @@index([isGust, aura, id])
  @@index([isGust, trendingScore, id])
  @@index([userId, isGust, createdAt])
  @@index([communityId, createdAt])
  @@index([parentPostId, createdAt])
  @@index([rootPostId, createdAt])
  @@index([threadTopId, createdAt])
  @@map("posts")
}

model PostVisit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, visitedAt])
  @@index([postId])
  @@map("post_visits")
}

model RecommendationEvent {
  id         String   @id @default(cuid())
  userId     String
  postId     String
  eventType  String
  durationMs Int?
  dedupeKey  String?  @unique
  value      Float?
  sessionId  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, createdAt])
  @@index([postId, eventType, createdAt])
  @@index([userId, postId, createdAt])
  @@map("recommendation_events")
}

model BackfillMarker {
  name        String   @id
  completedAt DateTime @default(now()) @map("completed_at")

  @@map("backfill_markers")
  @@ignore
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Community {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  description   String
  topics        String[]             @default([])
  type          CommunityType        @default(PUBLIC)
  mature        Boolean              @default(false)
  accentColor   String               @default("slate")
  ownerId       String
  owner         User                 @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  avatarUrl     String?
  avatarKey     String?
  avatarMediaId String?              @unique
  avatarMedia   Media?               @relation("CommunityAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerUrl     String?
  bannerKey     String?
  bannerMediaId String?              @unique
  bannerMedia   Media?               @relation("CommunityBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  members       CommunityMember[]
  visits        CommunityVisit[]
  posts         Post[]
  postShares    CommunityPostShare[]
  joinBonuses   CommunityJoinBonus[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([createdAt])
  @@index([ownerId])
  @@index([type])
  @@index([topics], type: Gin)
  @@map("communities")
}

model CommunityMember {
  id          String                @id @default(cuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole         @default(PARTICIPANT)
  status      CommunityMemberStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([communityId, role])
  @@index([communityId, status])
  @@map("community_members")
}

model CommunityVisit {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitedAt   DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([communityId, visitedAt])
  @@index([userId, visitedAt])
  @@map("community_visits")
}

model CommunityPostShare {
  id           String    @id @default(cuid())
  postId       String    @unique
  post         Post      @relation("CommunityPostShareTarget", fields: [postId], references: [id], onDelete: Cascade)
  sourcePostId String
  sourcePost   Post      @relation("CommunityPostShares", fields: [sourcePostId], references: [id], onDelete: Cascade)
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([sourcePostId])
  @@index([communityId])
  @@map("community_post_shares")
}

model CommunityJoinBonus {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinerAura  Int
  ownerAura   Int
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId, createdAt])
  @@map("community_join_bonuses")
}

enum CommunityType {
  PUBLIC
  RESTRICTED
  PRIVATE
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
  PARTICIPANT
}

enum CommunityMemberStatus {
  ACTIVE
  PENDING
}

model Media {
  id                   String           @id @default(cuid())
  postId               String?
  post                 Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId            String?
  comment              Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId               String?
  avatarOf             User?            @relation("UserAvatar")
  bannerOf             User?            @relation("UserBanner")
  communityAvatarOf    Community?       @relation("CommunityAvatar")
  communityBannerOf    Community?       @relation("CommunityBanner")
  url                  String
  key                  String           @default("")
  mimeType             String           @default("application/octet-stream")
  type                 MediaType        @default(IMAGE)
  size                 Int              @default(0)
  width                Int?
  height               Int?
  thumbnailKey         String?
  thumbnailWidth       Int?
  thumbnailHeight      Int?
  customThumbnailKey   String?
  hasHls               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  status               MediaStatus      @default(UPLOADING)
  visibility           MediaVisibility  @default(PUBLIC)
  originalKey          String?
  publishedKey         String?
  claimedMime          String?
  detectedMime         String?
  originalName         String?
  sha256               String?
  phash                String?
  rejectedReason       RejectionReason?
  failureCode          String?
  failureDetail        Json?
  attempts             Int              @default(0)
  techMetadata         Json?
  exifStripped         Boolean          @default(false)
  altText              String?
  generatedAltText     String?
  ocrText              String?
  transcript           String?
  captionsKey          String?
  semanticTags         String[]         @default([])
  safety               Json?
  semantics            Json?
  aiGenerated          Boolean?
  aiProvenance         Json?
  pipelineVersion      String?
  processedAt          DateTime?
  audioOverlayId       String?          @unique
  audioOverlay         Media?           @relation("AudioOverlay", fields: [audioOverlayId], references: [id], onDelete: SetNull)
  audioOverlayFor      Media[]          @relation("AudioOverlay")
  updatedAt            DateTime         @default(now()) @updatedAt
  blurDataUrl          String?
  platform             String           @default("asocialmedia.cc")
  uploaderDisplayName  String?
  uploaderUsername     String?
  encoderVersion       String?
  duplicateOf          String?
  originalProvenanceId String?
  reShareChecked       Boolean          @default(false)

  derivatives MediaDerivative[]

  @@index([commentId])
  @@index([status])
  @@index([sha256])
  @@index([phash])
  @@index([duplicateOf])
  @@index([originalProvenanceId])
  @@index([reShareChecked])
  @@index([postId])
  @@index([userId, createdAt])
  @@map("post_media")
}

model MediaDerivative {
  id              String   @id @default(cuid())
  mediaId         String
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind            String
  variant         String   @default("default")
  key             String
  mimeType        String
  width           Int?
  height          Int?
  sizeBytes       Int?
  durationMs      Int?
  pipelineVersion String
  createdAt       DateTime @default(now())

  @@unique([mediaId, kind, variant])
  @@index([key])
  @@map("post_media_derivatives")
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  PROCESSING
  READY
  FAILED
  REJECTED
  DELETED
}

enum RejectionReason {
  MALWARE
  MIME_MISMATCH
  UNSUPPORTED_TYPE
  TOO_LARGE
  TOO_LONG
  CORRUPT
  POLICY
}

enum MediaVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Vote {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  value          Int
  awardedAura    Int      @default(0)
  mutingCostAura Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, value, createdAt])
  @@map("votes")
}

model CommentVote {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value          Int
  awardedAura    Int      @default(0)
  mutingCostAura Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId, value])
  @@map("comment_votes")
}

model Bookmark {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId         String
  post           Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  bookmarkerAura Int    @default(0)
  authorAura     Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model HNBookmark {
  id        String   @id @default(cuid())
  userId    String
  storyId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, storyId])
  @@index([userId, createdAt])
  @@index([userId])
}

model HNStoryShare {
  id          String   @id @default(cuid())
  postId      String   @unique
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  storyId     Int
  title       String
  url         String?
  by          String
  time        Int
  score       Int
  descendants Int
  createdAt   DateTime @default(now())

  @@map("hn_story_shares")
}

model Comment {
  id               String         @id @default(cuid())
  content          String
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId           String
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  rootId           String?
  root             Comment?       @relation("CommentRoots", fields: [rootId], references: [id], onDelete: SetNull)
  replies          Comment[]      @relation("CommentReplies")
  rootComments     Comment[]      @relation("CommentRoots")
  aura             Int            @default(0)
  creationAura     Int            @default(0)
  receivedAura     Int            @default(0)
  postReceivedAura Int            @default(0)
  deleted          Boolean        @default(false)
  attachments      Media[]
  votes            CommentVote[]
  auraLogs         AuraLog[]
  notifications    Notification[]
  createdAt        DateTime       @default(now())

  @@index([postId, createdAt])
  @@index([postId, parentId])
  @@index([postId, rootId, createdAt])
  @@map("comments")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuerId    String
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type        NotificationType
  read        Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([commentId])
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([issuerId, type, createdAt])
  @@map("notifications")
}

enum NotificationType {
  AMPLIFY
  FOLLOW
  COMMENT
  MENTION
  MODERATION
  PUBLISHED
  REPLY
  TRANSCRIPTION
}

model Mention {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("mentions")
}

model ShareStats {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  String
  shares    Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, platform])
  @@map("share_stats")
}

model jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  alg        String?
  crv        String?
  expiresAt  DateTime?
}
