{
  "name": "@asm/db",
  "version": "1.1.68",
  "private": true,
  "description": "asocialmedia database & cache package",
  "license": "AGPL-3.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./communities": {
      "types": "./src/communities/shared.ts",
      "default": "./src/communities/shared.ts"
    },
    "./dates": {
      "types": "./src/dates.ts",
      "default": "./src/dates.ts"
    },
    "./recommendation/trending-snapshot": {
      "types": "./src/recommendation/trending-snapshot.ts",
      "default": "./src/recommendation/trending-snapshot.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:gen": "prisma contract emit",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:status": "prisma migration status",
    "db:sign": "prisma db sign --no-advance-ref",
    "db:verify": "prisma db verify"
  },
  "dependencies": {
    "@asm/config": "workspace:*",
    "@asm/logger": "workspace:*",
    "@asm/notifications": "workspace:*",
    "@aws-sdk/client-s3": "^3.1109.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@smithy/node-http-handler": "^4.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "bullmq": "^6.1.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "pg": "8.18.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.21.0",
    "bun-types": "^1.4.0",
    "prisma": "8.0.0-rc.15",
    "typescript": "^7.0.2"
  }
}
