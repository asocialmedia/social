{
  "expo": {
    "name": "asocialmedia",
    "slug": "asocialmedia",
    "version": "0.1.44",
    "description": "The social network that knows you back. A feed that learns your taste, Aura that remembers what you contribute, and communities you have to earn.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asocialmedia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "associatedDomains": ["webcredentials:asocialmedia.cc"],
      "bundleIdentifier": "cc.asocialmedia.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "cc.asocialmedia.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f1f1f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-abi-splits",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow asocialmedia to use your camera to capture photos and videos for your posts.",
          "microphonePermission": "Allow asocialmedia to record audio when you capture videos for your posts.",
          "photosPermission": "Allow asocialmedia to access your photos and videos so you can attach them to posts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff9500",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
