{
  "expo": {
    "name": "asocialmedia",
    "slug": "asocialmedia",
    "version": "0.2.41",
    "description": "The social network that knows you back. A feed that learns your taste, Aura that remembers what you contribute, and communities you have to earn.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asocialmedia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "associatedDomains": [
        "webcredentials:asocialmedia.cc",
        "applinks:asocialmedia.cc",
        "applinks:www.asocialmedia.cc"
      ],
      "bundleIdentifier": "cc.asocialmedia.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "cc.asocialmedia.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/posts/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/users/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/a/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/messages/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/hashtag/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "pathPrefix": "/network/bluesky"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/messages"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/settings"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/gusts"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/discover"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/bookmarks"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/history"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/notifications"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/communities"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/login"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/external-post"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/external-profile"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/external-media"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/external-library"
            },
            {
              "scheme": "https",
              "host": "asocialmedia.cc",
              "path": "/external-following"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/posts/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/users/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/a/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/messages/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/hashtag/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "pathPrefix": "/network/bluesky"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/messages"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/settings"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/gusts"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/discover"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/bookmarks"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/history"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/notifications"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/communities"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/login"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/external-post"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/external-profile"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/external-media"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/external-library"
            },
            {
              "scheme": "https",
              "host": "www.asocialmedia.cc",
              "path": "/external-following"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f1f1f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-abi-splits",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow asocialmedia to use your camera to capture photos and videos for your posts.",
          "microphonePermission": "Allow asocialmedia to record audio when you capture videos for your posts.",
          "photosPermission": "Allow asocialmedia to access your photos and videos so you can attach them to posts."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow asocialmedia to use your camera to capture photos and videos for your posts.",
          "microphonePermission": "Allow asocialmedia to record audio when you capture videos for your posts.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff9500",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-media-library",
        {
          "granularPermissions": [],
          "savePhotosPermission": "Allow asocialmedia to save media you choose to your photo library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
