# Mobile dev env. Expo auto-loads this file on `expo start` / `expo run` and
# inlines only EXPO_PUBLIC_* vars into the bundle. Nothing here is a secret.
# Anything machine-specific belongs in `.env.local` (gitignored), which
# overrides this file.
#
# Run the app with `bun run dev:android` (or `bun mob:dev` at the repo root).
# It builds the Expo dev client (needed for native Google sign-in and
# passkeys; Expo Go cannot load native modules) and runs `adb reverse` for
# ports 3000/3001/8082 so `localhost` on the device reaches this machine.
#
# API base the app talks to (auth runs behind the web origin):
# - unset: http://localhost:3000 on every platform. Android relies on the
#   reverse above. One host for the API, the auth service's OAuth redirect
#   (localhost:3001) and the Turnstile page keeps cookies and redirects
#   aligned, which is what lets browser-based OAuth (Reddit) finish in dev.
# - cannot reverse (plain `bun run start:go` without adb): use the emulator
#   alias. Email login works; browser OAuth does not. Note the web proxy
#   exempts loopback hosts from its cross-site and install-token gates, so
#   with the localhost default the install gate never fires in dev (signing
#   in is token-free everywhere anyway; the gate guards later mutations).
#   Point at the alias below to exercise that gate end to end.
# EXPO_PUBLIC_DEV_API_URL=http://10.0.2.2:3000
# - physical device: prefer USB + the reverse. Over Wi-Fi use your LAN IP
#   (browser OAuth will not complete because the redirect targets localhost).
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.5:3000
# - test PROD from a dev build (the only way to exercise passkeys, which need
#   an https relying party):
# EXPO_PUBLIC_DEV_API_URL=https://asocialmedia.cc
#
# Release builds use EXPO_PUBLIC_API_URL (baked at build time), defaulting
# to https://asocialmedia.cc. Only set it here to preview prod behavior.
# EXPO_PUBLIC_API_URL=https://asocialmedia.cc
#
# Google sign-in (native, ID-token flow). This is the WEB OAuth client id of
# the auth server (GOOGLE_CLIENT_ID): the native SDK mints ID tokens with it
# as the audience, which is exactly what the auth service already verifies.
# OAuth client ids are public by design. Google additionally requires an
# Android OAuth client for package cc.asocialmedia.mobile with the SHA-1 of
# the signing keystore (debug: android/app/debug.keystore after prebuild;
# release: android-signing/release.keystore) in the same Cloud project, or
# the SDK returns DEVELOPER_ERROR. Unset => the Google button falls back to
# the browser-based flow.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=724936986991-xxxxxxxx.apps.googleusercontent.com
#
# GitHub repo used by the force-update gate (default: asocialmedia/social).
# EXPO_PUBLIC_GITHUB_REPO=asocialmedia/social
#
# Cloudflare Turnstile site key, used by the install-credential verification
# gate. Public by design (it ships in the app and is served to every browser on
# the web signup page); the matching secret stays server-side. Without it the
# gate renders but cannot complete, so it is set here rather than left blank.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEuKQSsPABv2HAdA
#
# Origin the Turnstile page claims. A sitekey is bound to hostnames, so the
# inline challenge page must sit on one Cloudflare recognises - inline HTML on
# its own has no hostname and the widget fails with error 110200 ("unable to
# connect to website"). It must ALSO be in the server's TURNSTILE_HOSTNAMES
# allowlist on siteverify. With the default API base this equals the API
# origin; it only needs setting when EXPO_PUBLIC_DEV_API_URL points elsewhere.
# Release builds omit this and default to the production origin.
EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost:3000
#
# Mobile telemetry (react-native-otel, OTLP/HTTP JSON). Dev builds always log
# to the Metro console and never ship, even with these set. Release builds
# ship only when the endpoint is set; the token is optional (self-hosted
# collectors on a private net usually need no auth - never put user
# credentials here, they would ship inside the APK).
# EXPO_PUBLIC_OTEL_ENDPOINT=https://openobserve.example.com/api/default
# EXPO_PUBLIC_OTEL_TOKEN=
#
# Expo push notifications. The app registers an Expo push token and the worker
# delivers through Expo's push service. Needs the EAS project id (public by
# design) and, for Android, Firebase credentials configured on the Expo project
# (google-services.json / an FCM V1 service account). Without the project id,
# native push registration is skipped and the rest of the app is unaffected.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
