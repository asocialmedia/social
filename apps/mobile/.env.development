# API base. Unset = http://localhost:3000, one host for the API, OAuth redirect
# and Turnstile page (web OAuth needs this). Override per setup:
# EXPO_PUBLIC_DEV_API_URL=http://10.0.2.2:3000      # emulator, no adb reverse
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.5:3000   # Wi-Fi device (no web OAuth)
# EXPO_PUBLIC_DEV_API_URL=https://asocialmedia.cc   # test prod (passkeys need https)
# Release builds use EXPO_PUBLIC_API_URL, defaulting to https://asocialmedia.cc.
# EXPO_PUBLIC_API_URL=https://asocialmedia.cc

# Native Google sign-in: the auth server's web OAuth client id (public). It
# MUST equal the auth service's GOOGLE_CLIENT_ID, because the ID token the SDK
# mints carries it as the audience and the server verifies that audience.
# Setting it turns on the native account picker; the browser flow stays as the
# fallback if the SDK cannot run. Also needs an Android OAuth client in the
# same Google Cloud project for cc.asocialmedia.mobile with the signing SHA-1
# (debug keystore for dev builds, release keystore for release), or the SDK
# returns DEVELOPER_ERROR and the app falls back to the browser.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=724936986991-vlfbh46niac7aiqnp1ud0sos80fnom08.apps.googleusercontent.com

# Repo the support gate points an out-of-date build at. Defaults to
# asocialmedia/social, and resolves to the latest release page.
# EXPO_PUBLIC_GITHUB_REPO=asocialmedia/social

# Where the support gate sends a build the server no longer serves. Only
# needed when that is NOT the GitHub release page (a Play Console listing, a
# mirror). The app never downloads or installs anything itself: this is opened
# in the browser, which is what Play Store policy requires now that the
# in-app APK installer and its REQUEST_INSTALL_PACKAGES permission are gone.
# EXPO_PUBLIC_MOBILE_UPDATE_URL=https://asocialmedia.cc/download

# Turnstile site key (public) + the hostname the inline challenge page claims.
# Sitekey must be bound to TURNSTILE_BASE_URL's host and allowlisted server-side.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEuKQSsPABv2HAdA
EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost:3000

# Telemetry (OTLP/HTTP). Dev always logs to Metro; release ships only if set.
# EXPO_PUBLIC_OTEL_ENDPOINT=https://openobserve.example.com/api/default
# EXPO_PUBLIC_OTEL_TOKEN=
