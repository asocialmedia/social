# Mobile dev env. Expo auto-loads this file on `expo start` and inlines only
# EXPO_PUBLIC_* vars into the bundle. Nothing here is a secret. Anything
# machine-specific (your LAN IP) belongs in `.env.local` (gitignored),
# which overrides this file.
#
# API base the app talks to (auth runs behind the web origin):
# - unset: Android emulator -> http://10.0.2.2:3000, iOS sim -> http://localhost:3000
# - physical device over LAN: set your machine's LAN IP below
# - test PROD from a dev build (required for OAuth + native passkeys):
#   set this to https://asocialmedia.cc
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.5:3000
#
# Release builds use EXPO_PUBLIC_API_URL (baked at build time), defaulting
# to https://asocialmedia.cc. Only set it here to preview prod behavior.
# EXPO_PUBLIC_API_URL=https://asocialmedia.cc
#
# GitHub repo used by the force-update gate (default: asocialmedia/social).
# EXPO_PUBLIC_GITHUB_REPO=asocialmedia/social
#
# Cloudflare Turnstile site key, used by the install-credential verification
# gate. Public by design (it ships in the app and is served to every browser on
# the web signup page); the matching secret stays server-side. Without it the
# gate renders but cannot complete, so it is set here rather than left blank.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEuKQSsPABv2HAdA
#
# Mobile telemetry (react-native-otel, OTLP/HTTP JSON). Dev builds always log
# to the Metro console and never ship, even with these set. Release builds
# ship only when the endpoint is set; the token is optional (self-hosted
# collectors on a private net usually need no auth - never put user
# credentials here, they would ship inside the APK).
# EXPO_PUBLIC_OTEL_ENDPOINT=https://openobserve.example.com/api/default
# EXPO_PUBLIC_OTEL_TOKEN=
