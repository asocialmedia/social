NODE_ENV=production
PROTOCOLS_HOST=0.0.0.0
PROTOCOLS_PORT=3012
PROTOCOLS_INTERNAL_TOKEN=
PROTOCOLS_JETSTREAM_ENABLED=false
PROTOCOLS_BLUESKY_DIDS=
