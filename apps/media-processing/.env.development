# Media pipeline worker - development defaults.
# Real secrets live in the gitignored root .env; values here are fill-ins and
# never override anything already loaded from the root file.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asocialmedia?schema=public"
REDIS_URL="redis://:asmredis@localhost:6379/0"

ASMOB_ENDPOINT="http://localhost:9090"
ASMOB_BUCKET_NAME="uploads"
ASMOB_ROOT_USER="asmob-admin"
ASMOB_ROOT_PASSWORD="asmob-admin"
ASMOB_REGION="ap-south-1"

CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
MEDIA_REQUIRE_CLAMAV=1
MEDIA_SCAN_CONCURRENCY=4
MEDIA_HEALTH_PORT=3010

NODE_ENV="development"
LOG_LEVEL="info"
OTEL_SERVICE_NAME="media-processing"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:5080/api/default"
OPENOBSERVE_ORG="default"
OPENOBSERVE_LOG_STREAM="asm_media_logs"
OPENOBSERVE_METRIC_STREAM="asm_media_metrics"
OPENOBSERVE_TRACE_STREAM="asm_media_traces"

# C2PA provenance stamping identity (dev pair generated via
# bun scripts/generate-c2pa-cert.ts). Paths relative to this app dir.
MEDIA_C2PA_CERT_PATH="../../.dev-c2pa/chain.pem"
MEDIA_C2PA_KEY_PATH="../../.dev-c2pa/key.pem"
MEDIA_C2PA_STAMP=1
