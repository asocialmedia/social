DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asocialmedia?schema=public"
KLIPY_APP_KEY=""
ASMOB_ROOT_USER="asmob-admin"
ASMOB_ROOT_PASSWORD="asmob-admin"
ASMOB_BUCKET_NAME="uploads"
ASMOB_ENDPOINT="http://localhost:9090"
REDIS_URL="redis://:asmredis@localhost:6379/0"
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_URL="https://social.localhost"
# Must match apps/auth's BETTER_AUTH_SECRET. Used as the internal secret for
# server-to-server auth calls (x-internal-secret header).
BETTER_AUTH_SECRET="dev-secret-auth-local-32-chars-minimum"
SUPPORT_EMAIL="hello@asocialmedia.cc"
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
BETTER_AUTH_TELEMETRY=0
