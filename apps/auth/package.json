{
  "name": "@asm/auth-app",
  "version": "1.0.42",
  "private": true,
  "description": "Asocialmedia Auth Service",
  "scripts": {
    "build": "bun build --compile --minify --target=bun-linux-x64-musl ./src/server.ts --outfile ./dist/auth-server",
    "check-types": "tsc --noEmit",
    "dev": "cross-env NODE_ENV=development portless auth bun --watch src/server.ts",
    "start": "bun run src/server.ts"
  },
  "dependencies": {
    "@asm/auth": "workspace:*",
    "@asm/config": "workspace:*",
    "@asm/db": "workspace:*",
    "@asm/logger": "workspace:*",
    "@prisma/client": "7.9.1",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.26",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "prisma": "7.9.1",
    "typescript": "^7.0.2"
  }
}
