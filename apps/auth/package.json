{
  "name": "@asm/auth-app",
  "version": "1.0.91",
  "private": true,
  "description": "asocialmedia Auth Service",
  "scripts": {
    "build": "target=$(bash scripts/resolve-build-target.sh); bun build --compile --minify --target=$target --external msgpackr-extract ./src/server.ts --outfile ./dist/auth-server",
    "build:worker": "target=$(bash scripts/resolve-build-target.sh); bun build --compile --minify --target=$target --external msgpackr-extract ./src/worker.ts --outfile ./dist/asm-worker",
    "check-types": "tsc --noEmit",
    "dev": "cross-env NODE_ENV=development portless auth bun --watch src/dev.ts",
    "dev:worker": "bun --watch src/worker.ts",
    "start": "bun run src/server.ts",
    "start:worker": "bun run src/worker.ts"
  },
  "dependencies": {
    "@asm/aggregator": "workspace:*",
    "@asm/auth": "workspace:*",
    "@asm/config": "workspace:*",
    "@asm/db": "workspace:*",
    "@asm/logger": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "7.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.26",
    "bullmq": "^6.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "pg": "8.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "prisma": "7.9.1",
    "typescript": "^7.0.2"
  }
}
