DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asocialmedia?schema=public"
BETTER_AUTH_SECRET="dev-secret-auth-local-32-chars-minimum"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
RESEND_API_KEY=

AUTH_URL="https://auth.localhost"
APP_URL="https://social.localhost"
SUPPORT_EMAIL="hello@asocialmedia.cc"
NODE_ENV="development"
TURBO_TELEMETRY_DISABLED=1
BETTER_AUTH_TELEMETRY=0

OTEL_ENABLED="false"
OTEL_SERVICE_NAME="auth"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:5080/api/default"
OPENOBSERVE_USER="root@example.com"
OPENOBSERVE_PASSWORD="Complexpass#123"
OPENOBSERVE_ORG="default"
OPENOBSERVE_LOG_STREAM="auth_logs"
OPENOBSERVE_METRIC_STREAM="auth_metrics"
OPENOBSERVE_TRACE_STREAM="auth_traces"
LOG_LEVEL="info"


# Security (optimal defaults apply when unset, even in prod)
# Requests without a browser Origin are rejected unless they carry the shared
# BETTER_AUTH_SECRET as the `x-internal-secret` header (sent by apps/web).
# Browser calls are only accepted when the Origin matches APP_URL or AUTH_URL.
# Max request body size in bytes.
AUTH_MAX_BODY_BYTES=102400
# Max concurrent in-flight requests before shedding load.
AUTH_MAX_CONCURRENT_REQUESTS=512
# Server idle timeout in ms.
AUTH_REQUEST_TIMEOUT_MS=15000
# Authenticated users (valid session cookie) - generous so normal browsing
# never trips the limiter.
AUTH_AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_AUTH_RATE_LIMIT_MAX=600
# Anonymous requests - moderate per-IP throttle for unauthenticated scraping.
AUTH_ANON_RATE_LIMIT_WINDOW_MS=60000
AUTH_ANON_RATE_LIMIT_MAX=120
# Sensitive endpoints (sign-in, sign-up, OTP, reset) - tight anti-bruteforce.
AUTH_STRICT_RATE_LIMIT_WINDOW_MS=60000
AUTH_STRICT_RATE_LIMIT_MAX=30
# Continuous-polling detection - blocks scripts hammering the API in a few
# seconds. Real users never send 30 requests in 5 seconds.
AUTH_BURST_RATE_LIMIT_WINDOW_MS=5000
AUTH_BURST_RATE_LIMIT_MAX=30
