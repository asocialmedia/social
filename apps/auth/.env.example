DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asocialmedia?schema=public"
BETTER_AUTH_SECRET="dev-secret-auth-local-32-chars-minimum"
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_MASTER_KEY="masterKey123"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
RESEND_API_KEY=

AUTH_URL="https://auth.localhost"
APP_URL="https://social.localhost"
SUPPORT_EMAIL="hello@asocialmedia.cc"
NODE_ENV="development"
TURBO_TELEMETRY_DISABLED=1
BETTER_AUTH_TELEMETRY=0

# OpenObserve / OpenTelemetry
# Leave OTEL_ENABLED="false" if you are not running OpenObserve locally.
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="auth"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:5080/api/default"
OPENOBSERVE_USER="root@example.com"
OPENOBSERVE_PASSWORD="Complexpass#123"
OPENOBSERVE_ORG="default"
OPENOBSERVE_LOG_STREAM="auth_logs"
OPENOBSERVE_METRIC_STREAM="auth_metrics"
OPENOBSERVE_TRACE_STREAM="auth_traces"
LOG_LEVEL="info"
