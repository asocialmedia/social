{
  "name": "@asocialmedia/social",
  "version": "1.10.3",
  "private": true,
  "homepage": "https://asocialmedia.cc",
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "oxfmt --write && oxlint --fix-dangerously",
    "db:migrate": "bun run --filter=@asm/db db:migrate",
    "postinstall": "bun run db:gen",
    "bench:search": "bun scripts/bench-index-against-seed.ts",
    "test:recommendation:integration": "bun test --env-file=.env.test ./packages/db/src/recommendation/feed-service.integration.test.ts",
    "seed:dev:dry": "bun scripts/development/seed-dev-content.ts --dry-run",
    "mob:emu": "bun scripts/development/run-emulator.ts",
    "dep:check": "bunx sherif -f",
    "mob:dev": "bun --cwd apps/mobile dev:android",
    "test": "bun scripts/testing/run-tests.ts",
    "dev": "turbo dev",
    "mob": "bun --cwd apps/mobile start",
    "db:prebuild-dm-indexes": "bun run --cwd packages/db --env-file=../../.env.test src/messages/prebuild-indexes.ts",
    "docker:clean": "docker compose -f docker/docker-compose.dev.yml down -v && docker volume rm asmdev-postgres18-data asmdev-redis-data asmdev-asmob-data asmdev-redisinsight-data && rm -f .dev-init",
    "check-types": "tsc --project scripts/tsconfig.json && turbo check-types",
    "test:coverage": "bun scripts/testing/run-coverage-suite.ts",
    "seed:dm": "bun scripts/seed-dm-history.ts",
    "build": "turbo check-types && turbo build",
    "db:up": "bun run db:gen && bun run --cwd packages/db --env-file=../../.env.test prisma db update",
    "seed:dev": "bun scripts/development/seed-dev-content.ts --fresh",
    "docker:dev": "bun scripts/development/dev-init.ts",
    "apk": "bun apps/mobile/scripts/build-android-apk.ts",
    "predev": "bun scripts/development/dev-preflight.ts",
    "db:gen": "bun run --cwd packages/db prisma skills sync && bun run --cwd packages/db prisma contract emit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.0",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prisma": "8.0.0-rc.20",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.4",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@better-fetch/fetch": "1.3.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@smithy/core": "^3.31.1",
    "@smithy/types": "^4.16.1",
    "pg": "8.18.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.5"
  },
  "packageManager": "bun@1.4.0"
}
