{
  "name": "asocialmedia/social",
  "version": "1.0.52",
  "private": true,
  "homepage": "https://asocialmedia.cc",
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo check-types && turbo build",
    "check": "ultracite check",
    "check-types": "tsc --project scripts/tsconfig.json && turbo check-types",
    "db:gen": "bun run --filter=@asm/db generate",
    "db:push": "bun run --filter=@asm/db push",
    "db:up": "bun run --filter=@asm/db generate && bun run --filter=@asm/db push",
    "dep:check": "bunx sherif -f",
    "predev": "bun scripts/dev-preflight.ts",
    "dev": "turbo dev",
    "docker:clean": "docker compose -f docker/docker-compose.dev.yml down -v && docker volume rm asmdev-postgres18-data asmdev-redis-data asmdev-asmob-data asmdev-redisinsight-data && rm -f .dev-init",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml --profile init --profile studio up -d",
    "postinstall": "bun run --filter=@asm/db db:generate",
    "search:init": "cd packages/db && bunx tsx scripts/init-meilisearch.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:coverage": "bun run test:coverage:all",
    "test:coverage:all": "bun scripts/run-coverage-suite.ts all",
    "test:coverage:integration": "bun scripts/run-coverage-suite.ts integration",
    "test:coverage:unit": "bun scripts/run-coverage-suite.ts unit",
    "test:integration": "cross-env NODE_ENV=test bun scripts/run-integration-tests.ts",
    "test:unit": "cross-env NODE_ENV=test bun scripts/run-unit-tests.ts"
  },
  "overrides": {
    "@radix-ui/react-dialog": "^1.1.23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^2.31.1",
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "^1.3.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.10",
    "meilisearch": "^0.60.0",
    "portless": "^0.15.5",
    "prisma": "7.9.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.2"
  },
  "packageManager": "bun@1.3.12"
}
