NODE_ENV=test

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/asocialmedia?schema=public"
# Dedicated Redis database for the test suite. Dev processes use DB 0; sharing
# it lets live stream consumers (e.g. the view-flush worker) race integration
# assertions that write-then-read the same keys. DB 15 keeps suite state
# isolated with no other config change (all clients resolve REDIS_URL).
REDIS_URL="redis://:asmredis@localhost:6379/15"
BETTER_AUTH_SECRET="test-secret-auth-local-32-chars-minimum"
NEXTAUTH_SECRET="test-secret"
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3001"
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3001"
RESEND_API_KEY="test_key"
SUPPORT_EMAIL="hello@asocialmedia.cc"
ASMOB_ENDPOINT="http://localhost:9090"

CHECKPOINT_DISABLE=1
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
BETTER_AUTH_TELEMETRY=0
